modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["revenuecat:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"
packages = ["eas-cli", "pm2"]

[userenv]

[userenv.shared]
CF_ACCOUNT_ID = "53dff4976d55c17ec94ebe6306d0cffc"
CF_R2_BUCKET_NAME = "swimnotepicture"
CF_R2_VIDEO_BUCKET_NAME = "swimnotevideo"
