{
  "name": "@workspace/swimnote-dashboard",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --config vite.config.ts --host 0.0.0.0",
    "build": "vite build --config vite.config.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "desktop:typecheck": "tsc -p desktop/tsconfig.json --noEmit && tsc -p tsconfig.desktop.json --noEmit",
    "desktop:test": "vitest run --config desktop/vitest.config.ts",
    "desktop:build": "vite build --config vite.desktop.config.ts && tsc -p desktop/tsconfig.json",
    "desktop:package:win": "node desktop/package-windows.mjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@radix-ui/react-collapsible": "^1.1.4",
    "@radix-ui/react-dialog": "^1.1.7",
    "@radix-ui/react-dropdown-menu": "^2.1.7",
    "@radix-ui/react-label": "^2.1.3",
    "@radix-ui/react-slot": "^1.2.0",
    "@radix-ui/react-tooltip": "^1.2.0",
    "@tailwindcss/vite": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@testing-library/react": "16.3.2",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "electron": "44.7.2",
    "jsdom": "30.0.1",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "vite": "catalog:",
    "vitest": "4.1.10",
    "wouter": "^3.3.5",
    "zod": "catalog:"
  },
  "dependencies": {
    "xlsx": "0.18.5"
  }
}
