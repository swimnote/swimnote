{
  "name": "@workspace/api-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_ENV=development tsx ./src/index.ts",
    "dev:worker": "NODE_ENV=development WORKER_MODE=true tsx ./src/index.ts",
    "build": "tsx ./build.ts",
    "start": "node dist/index.mjs",
    "start:worker": "WORKER_MODE=true node dist/index.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pre-backup": "tsx ./src/scripts/pre-backup.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1014.0",
    "@aws-sdk/lib-storage": "^3.1014.0",
    "@aws-sdk/s3-request-presigner": "^3.1070.0",
    "@replit/object-storage": "^1.0.0",
    "@types/multer": "^2.1.0",
    "@types/node-cron": "^3.0.11",
    "@types/qrcode": "^1.5.6",
    "@workspace/api-zod": "workspace:*",
    "@workspace/db": "workspace:*",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2",
    "drizzle-orm": "catalog:",
    "express": "^5",
    "fflate": "^0.8.3",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "openai": "^7.0.0",
    "otplib": "^13.4.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@smithy/util-stream": "^4.8.2",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "catalog:",
    "@types/supertest": "^7.2.1",
    "aws-sdk-client-mock": "^4.1.0",
    "esbuild": "^0.27.3",
    "supertest": "^7.2.2",
    "tsx": "catalog:",
    "vitest": "^4.1.10"
  }
}
