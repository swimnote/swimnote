{
  "expo": {
    "name": "SwimNote",
    "slug": "swim-app",
    "version": "2.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "swim-app",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-new.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.swimnote.app",
      "buildNumber": "252",
      "usesAppleSignIn": true,
      "entitlements": {
        "com.apple.developer.applesignin": [
          "Default",
          "Default"
        ]
      },
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "SwimNote accesses your photo library to attach photos to class lesson diaries and progress reports. For example, a teacher can attach a photo from the gallery to document a student's swimming technique during a lesson.",
        "NSPhotoLibraryAddUsageDescription": "SwimNote saves photos to your photo library when you download lesson diary images or class photos shared by your swimming instructor.",
        "NSCameraUsageDescription": "SwimNote uses the camera to take photos directly for lesson diaries and class progress documentation. For example, a teacher can photograph a student's swimming form to include in the lesson record.",
        "NSMicrophoneUsageDescription": "SwimNote uses the microphone to record short voice memos for lesson diaries. A teacher can speak lesson notes aloud and have them transcribed automatically.",
        "LSApplicationQueriesSchemes": [
          "kakaokompassauth",
          "storekvstore",
          "kakaolink",
          "kakaotalk",
          "kakaostory",
          "kakaoplus",
          "kakaonavi",
          "kakaomail",
          "kakaoopen"
        ]
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "pan",
      "package": "com.swimnote.app",
      "versionCode": 238,
      "allowBackup": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.CAMERA",
        "android.permission.INTERNET",
        "android.permission.VIBRATE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Pretendard-Regular.otf",
            "./assets/fonts/Pretendard-Medium.otf",
            "./assets/fonts/Pretendard-SemiBold.otf",
            "./assets/fonts/Pretendard-Bold.otf"
          ]
        }
      ],
      "expo-apple-authentication",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#1A5CFF"
        }
      ],
      [
        "@react-native-seoul/kakao-login",
        {
          "kakaoAppKey": "0c984af3a5fcb64715c2cf3cc76c55ca",
          "kotlinVersion": "2.1.21",
          "overrideKakaoSDKVersion": "2.22.0"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "SwimNote accesses your photo library to attach photos to lesson diaries.",
          "cameraPermission": "SwimNote uses the camera to take photos for lesson diaries."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "SwimNote saves photos to your photo library.",
          "savePhotosPermission": "SwimNote saves photos to your photo library.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "SwimNote uses the microphone to record short voice memos for lesson diaries. A teacher can speak lesson notes aloud and have them transcribed automatically."
        }
      ],
      "./plugins/withRemoveMediaPermissions",
      [
        "react-native-share",
        {
          "ios": [
            "instagram",
            "instagram-stories"
          ],
          "android": [
            "com.instagram.android"
          ]
        }
      ],
      "expo-build-properties",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-new.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF",
          "imageWidth": 140
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "7d0e0faa-32d8-4f40-88c4-2c99e0613afc"
      }
    },
    "owner": "swimnote",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7d0e0faa-32d8-4f40-88c4-2c99e0613afc",
      "checkAutomatically": "ON_LOAD"
    }
  }
}
